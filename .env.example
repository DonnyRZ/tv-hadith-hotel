# Application
NODE_ENV=development
APP_ENVIRONMENT=development
APP_NAME=room-service-hadith
RELEASE_ID=local
# Railway injects PORT for hosted services. API_PORT is the local fallback.
API_PORT=3000

# PostgreSQL (development defaults for Docker Compose)
POSTGRES_DB=room_service
POSTGRES_USER=room_service
POSTGRES_PASSWORD=room_service_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://room_service:room_service_dev_only@localhost:5432/room_service?schema=public

# Staff session (replace for any shared environment)
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_STORE=memory
AUTH_STORE=memory
TV_PAIRING_TTL_SECONDS=600
STAFF_REALTIME_ENABLED=true
REDIS_URL=redis://localhost:6379
# TV self-update is deliberately off until an immutable HTTPS APK location,
# checksum, and the unchanged production signing certificate are published.
TV_UPDATE_ENABLED=false
# TV_UPDATE_VERSION_CODE=11
# TV_UPDATE_VERSION_NAME=0.4.7
# TV_UPDATE_APK_URL=https://updates.example.com/egi-tv/11/app-release.apk
# TV_UPDATE_SHA256=<64-character-lowercase-sha256>
# TV_UPDATE_CERTIFICATE_SHA256=50dff6906e42e0ea5ee933225fadf4a55cb9a2050baaeafa3bff8b6d90820904
# TV_UPDATE_RELEASE_ID=tv-0.4.7
# TV_UPDATE_MANDATORY=false
# TV_UPDATE_MIN_SUPPORTED_VERSION_CODE=1
# Optional JSON seed for local development; passwords are hashed with Argon2id at startup.
# Email is the only supported staff login identifier.
# For local bootstrap, set this in an untracked apps/api/.env file and never commit the real password:
# STAFF_SEED_USERS_JSON=[{"email":"superadmin@hadith-hotel.com","displayName":"Donny","roles":["SUPERADMIN"],"password":"replace-locally"}]

# Local staff web (apps/staff-web/.env.local, also ignored by Git)
# STAFF_WEB_PORT=5174
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Hosted Staff/Guest Web runtime must set API_PROXY_TARGET to the API origin and
# keep VITE_API_BASE_URL=/api/v1 so the session cookie remains same-origin.
# API_PROXY_TARGET=https://api.example.com
# Staff Web realtime uses the same-origin /socket.io proxy. The API origin
# above must accept both /api/* and Socket.IO upgrade requests.

# Guest/staff web origins
GUEST_WEB_URL=http://localhost:5173
STAFF_WEB_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Required in hosted environments for the internal reservation-expiry endpoint.
# Keep this secret outside source control and rotate it like any service credential.
INTERNAL_WORKER_SECRET=replace-with-a-long-random-worker-secret
# Optional development-only QR fixture. Keep the raw token in an ignored local
# env file; production deliberately ignores these variables.
# GUEST_DEV_ROOM_NUMBER=201
# GUEST_DEV_ACCESS_TOKEN=generate-a-random-token-of-at-least-32-characters-locally

# MinIO (development defaults for Docker Compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=room-service-media

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_only
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
